# ==============================================================================
# PoySic Environment Configuration Template
# ==============================================================================
# Salin fail ini ke .env dalam folder server/ atau client/ mengikut keperluan:
# cp .env.example server/.env
# cp .env.example client/.env
#
# NOTA KESELAMATAN:
# JANGAN sekali-kali memasukkan atau commit kunci API sebenar ke dalam repositori git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (server/.env)
# ------------------------------------------------------------------------------
# Port pelayan backend PoySic (lalai: 3000)
PORT=3000

# Persekitaran: development | production
NODE_ENV=development

# Kunci API Jamendo v3.0 (Percuma untuk Creative Commons)
# Cara dapatkan:
# 1. Buka https://developer.jamendo.com
# 2. Daftar akaun pembangun percuma
# 3. Cipta aplikasi baru untuk mendapatkan "Client ID"
# Sekiranya dibiarkan kosong, PoySic akan menggunakan katalog pilihan (curated fallback).
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# URL Frontend untuk kebenaran CORS
# Contoh: http://localhost:5173 (dev) atau https://poysic.vercel.app (production)
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (client/.env)
# ------------------------------------------------------------------------------
# URL pelayan backend PoySic untuk sambungan Socket.IO & REST API
# Dalam pembangunan tempatan, biarkan kosong untuk menggunakan proksi Vite.
# Dalam pengeluaran (cth: Vercel), tetapkan ke URL backend anda:
# Contoh: VITE_SOCKET_URL=https://poysic-api.onrender.com
VITE_SOCKET_URL=
